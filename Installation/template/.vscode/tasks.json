{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "DPDK: build & run",
            "type": "shell",
            "command": "./run",
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"],
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
        },
        {
            // Unoptimized build in build-debug/, plus eal.conf turned into gdb "set args"
            "label": "DPDK: build debug",
            "type": "shell",
            "command": "[ -d build-debug ] || meson setup build-debug --buildtype=debug; ninja -C build-debug && printf 'set args %s\\n' \"$(sed 's/#.*//' eal.conf | tr '\\n' ' ')\" > build-debug/args.gdb",
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build",
            "problemMatcher": ["$gcc"],
            "presentation": { "reveal": "silent", "panel": "dedicated", "clear": true }
        }
    ]
}
