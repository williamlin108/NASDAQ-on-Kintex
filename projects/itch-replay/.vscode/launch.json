{
    "version": "0.2.0",
    "configurations": [
        {
            // F5: unoptimized build, args from eal.conf, gdb run via dpdk-run for mlx5 caps
            "name": "DPDK: debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build-debug/itch-replay",
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "DPDK: build debug",
            "MIMode": "gdb",
            "miDebuggerPath": "${env:HOME}/.local/bin/dpdk-gdb",
            "externalConsole": false,
            "setupCommands": [
                { "text": "-enable-pretty-printing", "ignoreFailures": true },
                { "text": "source ${workspaceFolder}/build-debug/args.gdb" }
            ]
        }
    ]
}
